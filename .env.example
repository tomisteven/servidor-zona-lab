NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/zona_lab_dev

# Redis opcional para rate limit compartido entre instancias.
# Acepta redis:// o rediss://. Sin valor usa memoria local.
REDIS_URL=

CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info
WHATSAPP_NUMBER=5491112345678

# Cookies del panel. Usar "none" si frontend y backend están en sitios distintos.
# "none" requiere HTTPS en producción. Valores: lax, strict, none.
COOKIE_SAME_SITE=lax

# Activar si el backend corre detrás de un proxy/plataforma que termina HTTPS.
TRUST_PROXY=false

# Generar con: npm run admin:hash -- "una contraseña de al menos 12 caracteres"
# Dejar los tres valores vacíos en desarrollo para deshabilitar el panel.
# SESSION_SECRET también cifra la contraseña SMTP configurada desde el panel.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Cloudinary para almacenar y servir las imágenes de productos.
# Dejar los tres valores vacíos para usar storage/media local.
# El folder se crea automáticamente. Ejemplo: zona-lab/media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zona-lab/media
