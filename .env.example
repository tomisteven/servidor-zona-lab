NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/zona_lab_dev
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info
WHATSAPP_NUMBER=5491112345678

# Cookies del panel. Usar "none" si frontend y backend están en sitios distintos.
# "none" requiere HTTPS en producción. Valores: lax, strict, none.
COOKIE_SAME_SITE=lax

# Activar si el backend corre detrás de un proxy/plataforma que termina HTTPS.
TRUST_PROXY=false

# Generar con: npm run admin:hash -- "una contraseña de al menos 12 caracteres"
# Dejar los tres valores vacíos en desarrollo para deshabilitar el panel.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
